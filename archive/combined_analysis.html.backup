        function getColorForValue(value, layer) {
            if (layer === 'disparity') {
                // Red scale for disparity (higher = worse)
                if (value >= 70) return '#B71C1C';
                if (value >= 50) return '#D32F2F';
                if (value >= 30) return '#F44336';
                if (value >= 10) return '#FF5252';
                return '#FFCDD2';
            } else if (layer === 'distance') {
                if (value >= 400) return '#D32F2F';
                if (value >= 200) return '#FB8C00';
                if (value >= 100) return '#FDD835';
                if (value >= 50) return '#66BB6A';
                return '#2E7D32';
            } else if (layer === 'income') {
                // Green scale for income (higher = better)
                if (value >= 100000) return '#1B5E20';
                if (value >= 75000) return '#2E7D32';
                if (value >= 50000) return '#66BB6A';
                if (value >= 25000) return '#FDD835';
                return '#D32F2F';
            } else if (layer === 'indigenous') {
                if (value >= 20) return '#0D47A1';
                if (value >= 10) return '#1565C0';
                if (value >= 5) return '#1976D2';
                if (value >= 1) return '#42A5F5';
                return '#90CAF9';
            } else if (layer === 'minority') {
                if (value >= 60) return '#4A148C';
                if (value >= 40) return '#6A1B9A';
                if (value >= 20) return '#8E24AA';
                if (value >= 10) return '#AB47BC';
                return '#E1BEE7';
            }
        }

        function initMap() {
            map = new google.maps.Map(document.getElementById('map'), {
                zoom: 4,
                center: { lat: 56.1304, lng: -106.3468 },
                mapTypeId: 'roadmap'
            });

            createMarkers();
            createCenterMarkers();
            updateChart();
        }

        function createMarkers() {
            // Clear existing markers
            markers.forEach(m => m.setMap(null));
            markers = [];

            fsaData.forEach(fsa => {
                let value, valueLabel;

                if (currentLayer === 'disparity') {
                    value = fsa.disparity_score;
                    valueLabel = `Disparity: ${value.toFixed(1)}/100`;
                } else if (currentLayer === 'distance') {
                    value = fsa.distance_to_nearest_km;
                    valueLabel = `Distance: ${value.toFixed(1)} km`;
                } else if (currentLayer === 'income') {
                    value = fsa.median_household_income_2020;
                    valueLabel = `Income: $${value.toLocaleString()}`;
                } else if (currentLayer === 'indigenous') {
                    value = fsa.indigenous_ancestry_rate;
                    valueLabel = `Indigenous: ${value.toFixed(2)}%`;
                } else if (currentLayer === 'minority') {
                    value = fsa.visible_minority_rate;
                    valueLabel = `Visible Minority: ${value.toFixed(2)}%`;
                }

                const marker = new google.maps.Marker({
                    position: { lat: fsa.latitude, lng: fsa.longitude },
                    map: map,
                    icon: {
                        path: google.maps.SymbolPath.CIRCLE,
                        scale: 7,
                        fillColor: getColorForValue(value, currentLayer),
                        fillOpacity: 0.7,
                        strokeColor: '#fff',
                        strokeWeight: 1
                    }
                });

                marker.addListener('click', () => {
                    showFSADetails(fsa);
                });

                markers.push(marker);
            });
        }

        function createCenterMarkers() {
            centerData.forEach(center => {
                new google.maps.Marker({
                    position: { lat: center.latitude, lng: center.longitude },
                    map: map,
                    icon: {
                        path: google.maps.SymbolPath.CIRCLE,
                        scale: 14,
                        fillColor: '#1976D2',
                        fillOpacity: 1,
                        strokeColor: '#fff',
                        strokeWeight: 3
                    },
                    title: center['Hospital Center'],
                    zIndex: 1000
                });
            });
        }

        function changeLayer() {
            currentLayer = document.querySelector('input[name="layer"]:checked').value;
            createMarkers();
            updateChart();
        }

        function showFSADetails(fsa) {
            const html = `
                <div class="metric">
                    <span class="metric-label">FSA</span>
                    <span class="metric-value">${fsa.FSA}</span>
                </div>
                <div class="metric">
                    <span class="metric-label">Disparity Score</span>
                    <span class="metric-value">${fsa.disparity_score.toFixed(1)}/100</span>
                </div>
                <div class="metric">
                    <span class="metric-label">Distance</span>
                    <span class="metric-value">${fsa.distance_to_nearest_km.toFixed(1)} km</span>
                </div>
                <div class="metric">
                    <span class="metric-label">Nearest Center</span>
                    <span class="metric-value" style="font-size: 11px;">${fsa.nearest_dbs_center}</span>
                </div>
                <div class="metric">
                    <span class="metric-label">Income</span>
                    <span class="metric-value">$${fsa.median_household_income_2020.toLocaleString()}</span>
                </div>
                <div class="metric">
                    <span class="metric-label">Gini Index</span>
                    <span class="metric-value">${fsa.gini_index.toFixed(3)}</span>
                </div>
                <div class="metric">
                    <span class="metric-label">Indigenous</span>
                    <span class="metric-value">${fsa.indigenous_ancestry_rate.toFixed(2)}%</span>
                </div>
                <div class="metric">
                    <span class="metric-label">Visible Minority</span>
                    <span class="metric-value">${fsa.visible_minority_rate.toFixed(2)}%</span>
                </div>
            `;
            document.getElementById('fsa-details').innerHTML = html;
        }

        function updateChart() {
            let values = [];
            let title = '';

            if (currentLayer === 'disparity') {
                values = fsaData.map(f => f.disparity_score);
                title = 'Disparity Score Distribution';
            } else if (currentLayer === 'distance') {
                values = fsaData.map(f => f.distance_to_nearest_km);
                title = 'Distance Distribution (km)';
            } else if (currentLayer === 'income') {
                values = fsaData.map(f => f.median_household_income_2020);
                title = 'Income Distribution ($)';
            } else if (currentLayer === 'indigenous') {
                values = fsaData.map(f => f.indigenous_ancestry_rate);
                title = 'Indigenous Ancestry Rate (%)';
            } else if (currentLayer === 'minority') {
                values = fsaData.map(f => f.visible_minority_rate);
                title = 'Visible Minority Rate (%)';
            }

            const trace = {
                x: values,
                type: 'histogram',
                marker: { color: '#6A1B9A' },
                nbinsx: 20
            };

            const layout = {
                title: { text: title, font: { size: 13 } },
                margin: { t: 40, b: 40, l: 40, r: 20 },
                height: 250,
                xaxis: { title: '' },
                yaxis: { title: 'Count' }
            };

            Plotly.newPlot('chart', [trace], layout, { displayModeBar: false });
        }

        window.onload = initMap;
    </script>
</body>
</html>
